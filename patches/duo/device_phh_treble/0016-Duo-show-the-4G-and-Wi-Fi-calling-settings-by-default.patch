From 672980fdcc1f86565051584f1d959e5e3387bbd2 Mon Sep 17 00:00:00 2001
From: Michael Kostersitz <mkostersitz@mac.com>
Date: Tue, 27 Oct 2026 22:41:49 +0000
Subject: [PATCH] Duo: show the 4G and Wi-Fi calling settings by default

Sets persist.dbg.volte_avail_ovr, persist.dbg.wfc_avail_ovr and persist.dbg.allow_ims_off to 1, the values the Treble app writes when Force the presence of 4G Calling setting is switched on, so a fresh install needs no toggle. The IMS service itself is not part of this change.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 system.prop | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/system.prop b/system.prop
index 31d2cdd..c8dc908 100644
--- a/system.prop
+++ b/system.prop
@@ -58,3 +58,7 @@ persist.sys.thain.duo.enable_settings_icons=1
 persist.sys.thain.duo.app_hinting=0
 # two panel window policy (only takes effect on the Duo): apps open on one screen, setup is not spread over the hinge
 persist.sys.phh.duo.panels=1
+# IMS: show the 4G / Wi-Fi calling settings without the Treble app toggle (Duo, Qualcomm IMS)
+persist.dbg.volte_avail_ovr=1
+persist.dbg.wfc_avail_ovr=1
+persist.dbg.allow_ims_off=1
-- 
2.43.0

