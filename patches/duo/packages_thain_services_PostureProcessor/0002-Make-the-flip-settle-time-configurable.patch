From 9561feb75d8a5e61317f086f7dfb653fac7dc1b7 Mon Sep 17 00:00:00 2001
From: Mike Kostersitz <mkostersitz@mac.com>
Date: Fri, 16 Oct 2026 02:35:14 +0000
Subject: [PATCH] Make the flip settle time configurable
 (persist.sys.phh.duo.flip_settle_ms)

Read on every flip, default 2000 ms, clamped to 0..10000 ms.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 .../kotlin/com/thain/duo/PostureProcessorService.kt    | 10 +++++++++-
 1 file changed, 9 insertions(+), 1 deletion(-)

diff --git a/src/main/kotlin/com/thain/duo/PostureProcessorService.kt b/src/main/kotlin/com/thain/duo/PostureProcessorService.kt
index e4bc7b0..732c9b4 100644
--- a/src/main/kotlin/com/thain/duo/PostureProcessorService.kt
+++ b/src/main/kotlin/com/thain/duo/PostureProcessorService.kt
@@ -311,7 +311,7 @@ public class PostureProcessorService : Service(), IHwBinder.DeathRecipient {
                 displayHal?.setComposition(2)
                 touchHalCompSet(2)
                 currentDisplayComposition = 2
-                handler.postDelayed({ setDisplay(composition) }, FLIP_SETTLE_MS)
+                handler.postDelayed({ setDisplay(composition) }, flipSettleMs())
                 return
             }
             displayHal?.setComposition(composition)
@@ -323,6 +323,14 @@ public class PostureProcessorService : Service(), IHwBinder.DeathRecipient {
         }
     }
 
+    // Set from the DUO-DE Treble Settings app, read on every flip so it applies without a reboot.
+    private fun flipSettleMs(): Long {
+        val ms = SystemProperties.get("persist.sys.phh.duo.flip_settle_ms", FLIP_SETTLE_MS.toString())
+            .toLongOrNull()?.coerceIn(0L, 10000L) ?: FLIP_SETTLE_MS
+        Log.d(TAG, "Flip settle time ${ms} ms")
+        return ms
+    }
+
     private fun setDisplay(composition: Int) {
         try {
             connectHalIfNeeded()
-- 
