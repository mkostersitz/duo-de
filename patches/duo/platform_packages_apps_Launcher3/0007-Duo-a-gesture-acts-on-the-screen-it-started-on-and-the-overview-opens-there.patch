diff --git a/quickstep/src/com/android/quickstep/TopTaskTracker.java b/quickstep/src/com/android/quickstep/TopTaskTracker.java
index 62fd14c174..d8d0cd0247 100644
--- a/quickstep/src/com/android/quickstep/TopTaskTracker.java
+++ b/quickstep/src/com/android/quickstep/TopTaskTracker.java
@@ -467,6 +467,50 @@ public class TopTaskTracker extends ISplitScreenListener.Stub implements TaskSta
             mActiveDeskId = activeDeskId;
         }
 
+        /**
+         * Duo: the running task for a gesture that started on one screen is the topmost visible task on that screen,
+         * or the home task when the screen shows home, not the task that happens to hold focus on the other screen.
+         * Only possible with the plain task list; with shell top task tracking this returns itself.
+         *
+         * @param panel the {left, top, right, bottom} rect of the screen the gesture started on
+         */
+        public CachedTaskInfo restrictedToPanel(int[] panel) {
+            if (mAllCachedTasks == null || mAllCachedTasks.isEmpty() || mContext == null) {
+                return this;
+            }
+            TaskInfo chosen = null;
+            TaskInfo home = null;
+            // The cached list can hold stale visibility (a minimized task still reads visible): ask for fresh state
+            final java.util.Set<Integer> visibleIds = new java.util.HashSet<>();
+            final RunningTaskInfo[] fresh = TraceHelper.allowIpcs("duo.visibleTasks", () ->
+                    ActivityManagerWrapper.getInstance().getRunningTasks(false /* filterOnlyVisibleRecents */));
+            if (fresh != null) {
+                for (RunningTaskInfo r : fresh) {
+                    if (r.isVisible()) visibleIds.add(r.taskId);
+                }
+            }
+            for (TaskInfo t : mAllCachedTasks) {
+                if (TopTaskTracker.isHomeTask(t)) {
+                    if (home == null) home = t;
+                    continue;
+                }
+                if (!visibleIds.contains(t.taskId)) continue;
+                final android.graphics.Rect b = t.configuration.windowConfiguration.getBounds();
+                final int cx = b.centerX();
+                final boolean spans = b.width() > 1.5f * (panel[2] - panel[0]);
+                if (spans || (cx >= panel[0] && cx < panel[2])) {
+                    chosen = t;
+                    break;
+                }
+            }
+            if (chosen == null) chosen = home;
+            if (chosen == null || chosen == mTopTask) return this;
+            final List<TaskInfo> reordered = new java.util.ArrayList<>(mAllCachedTasks);
+            reordered.remove(chosen);
+            reordered.add(0, chosen);
+            return new CachedTaskInfo(reordered, mContext, mDisplayId, mActiveDeskId);
+        }
+
         /**
          * Returns the "base" task that is used the as the representative running task of the set
          * of tasks initially provided.
