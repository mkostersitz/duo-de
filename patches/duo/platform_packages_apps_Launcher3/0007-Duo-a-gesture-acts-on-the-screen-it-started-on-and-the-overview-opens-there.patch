+    /** True when the last touch that could open the overview (a gesture or a tap) started on the right screen. */
+    private static volatile boolean sOverviewOnRight;
+
+    public static void setOverviewOnRight(boolean right) {
+        sOverviewOnRight = right;
+    }
+
+    /**
+     * The panel rect {l, t, r, b} the overview is laid out in: the screen the gesture started on, or null when the
+     * display is not a spanned / gapless Duo landscape.
+     */
+    public static int[] overviewPanel(int widthPx, int heightPx) {
+        int[][] halves = halves(widthPx, heightPx);
+        return halves == null ? null : halves[sOverviewOnRight ? 1 : 0];
+    }
+
     public static boolean isSpannedLandscape(int widthPx, int heightPx) {
         return halves(widthPx, heightPx) != null;
     }
