+    private void duoDragDown(MotionEvent ev) {
+        mDuoRestPos.set(ev.getRawX(), ev.getRawY());
+        mDuoRestSince = ev.getEventTime();
+        mDuoSpanArmed = false;
+    }
+
+    /** The two panel rects of the whole display (not of the window this service happens to be sized to), or null. */
+    private int[][] duoHalves() {
+        final android.graphics.Point real = duoRealSize();
+        return DuoPanels.halves(real.x, real.y);
+    }
+
+    private long duoRestMs(MotionEvent ev) {
+        return ev.getEventTime() - mDuoRestSince;
+    }
+
+    /** Tracks how long the finger has rested, and ticks once when resting where a drop would span the app. */
+    private void duoDragMove(MotionEvent ev) {
+        final float density = mDuoContext.getResources().getDisplayMetrics().density;
+        if (Math.hypot(ev.getRawX() - mDuoRestPos.x, ev.getRawY() - mDuoRestPos.y)
+                > DuoDragDrop.REST_DP * density) {
+            mDuoRestPos.set(ev.getRawX(), ev.getRawY());
+            mDuoRestSince = ev.getEventTime();
+        }
+        final android.util.DisplayMetrics dm = mDuoContext.getResources().getDisplayMetrics();
+        final int[][] halves = duoHalves();
+        if (halves == null || !mPassedWindowMoveSlop) return;
+        final boolean fromRight = mDuoFromRight();
+        final boolean inZone = DuoDragDrop.inSpanZone(halves, fromRight, ev.getRawX(), density)
+                && duoRestMs(ev) >= DuoDragDrop.requiredDwellMs(halves, ev.getRawX(), density);
+        if (inZone && !mDuoSpanArmed) {
+            android.util.Log.d("DuoDrag", "armed: click at x=" + ev.getRawX() + " rest=" + duoRestMs(ev));
+            final Vibrator v = mDuoContext.getSystemService(Vibrator.class);
+            if (v != null) v.vibrate(VibrationEffect.createPredefined(VibrationEffect.EFFECT_CLICK));
+        }
+        mDuoSpanArmed = inZone;
+    }
+
+    private int duoWidth() {
+        return duoRealSize().x;
+    }
+
+    /** The size of the whole display, whatever the window this service runs in is sized to. */
+    private android.graphics.Point duoRealSize() {
+        final android.graphics.Point real = new android.graphics.Point(
+                com.android.launcher3.util.DisplayController.INSTANCE.get(mDuoContext).getInfo().currentSize);
+        return real;
+    }
+
+    private boolean mDuoFromRight() {
+        final android.graphics.Rect b = mGestureState.getRunningTask() != null
+                && mGestureState.getRunningTask().getLegacyBaseTask() != null
+                ? mGestureState.getRunningTask().getLegacyBaseTask().configuration.windowConfiguration.getBounds()
+                : null;
+        return b != null && b.centerX() > duoWidth() / 2;
+    }
+
+    /**
+     * The span / move action to run once the gesture animation is done, or null when the gesture was no drag-and-drop
+     * of an app (not a Duo, no app, a fling, too short or too long a pull, or dropped where it stays).
+     */
+    private Runnable duoDropAction(MotionEvent ev, float velocityYPxPerMs) {
+        final android.util.DisplayMetrics dm = mDuoContext.getResources().getDisplayMetrics();
+        final int[][] halves = duoHalves();
+        final com.android.quickstep.TopTaskTracker.CachedTaskInfo top = mGestureState.getRunningTask();
+        if (halves == null || top == null || top.isHomeTask() || top.isRecentsTask()
+                || top.getLegacyBaseTask() == null || top.getLegacyBaseTask().configuration == null) {
+            android.util.Log.d("DuoDrag", "no drop: halves=" + (halves != null) + " top=" + top
+                    + (top != null ? " home=" + top.isHomeTask() + " recents=" + top.isRecentsTask() : ""));
+            return null;
+        }
+        final float pull = mDownPos.y - mLastPos.y;
+        if (pull < 60 * dm.density || pull > 0.30f * dm.heightPixels || velocityYPxPerMs < -1.0f) {
+            android.util.Log.d("DuoDrag", "no drop: pull=" + pull + " vy=" + velocityYPxPerMs);
+            return null;
+        }
+        final android.graphics.Rect bounds = top.getLegacyBaseTask().configuration.windowConfiguration.getBounds();
+        final boolean spanned = bounds.width() > halves[0][2] - halves[0][0] + 10;
+        final float x = ev.getRawX();
+        final long rest = duoRestMs(ev);
+        final int decision = spanned
+                ? DuoDragDrop.decideForSpannedApp(halves, x, rest, dm.density)
+                : DuoDragDrop.decideForPanelApp(halves, bounds.centerX() > duoWidth() / 2, x, rest, dm.density);
+        android.util.Log.d("DuoDrag", "x=" + x + " rest=" + rest + " spanned=" + spanned + " bounds=" + bounds
+                + " decision=" + decision);
+        if (decision == DuoDragDrop.NONE) {
+            // Dropped where the app stays: it goes back to where it was, it does not open the recents list, when the
+            // finger was moved sideways (a plain pull up is the home / recents gesture).
+            return Math.abs(mLastPos.x - mDownPos.x) >= 60 * dm.density ? () -> { } : null;
+        }
+        final int taskId = top.getTaskId();
+        final int display = mGestureState.getDisplayId();
+        final int feature = decision == DuoDragDrop.SPAN
+                ? com.android.internal.policy.DuoPanelGeometry.spannedTasksFeatureId()
+                : com.android.internal.policy.DuoPanelGeometry.panelTasksFeatureId(
+                        decision == DuoDragDrop.MOVE_TO_LEFT ? 0 : 1);
+        return () -> {
+            final ActivityOptions opts = ActivityOptions.makeBasic();
+            opts.setLaunchDisplayId(display);
+            opts.setLaunchTaskDisplayAreaFeatureId(feature);
+            opts.setLaunchWindowingMode(android.app.WindowConfiguration.WINDOWING_MODE_FULLSCREEN);
+            ActivityManagerWrapper.getInstance().startActivityFromRecents(taskId, opts);
+        };
     }
 
     private void removeListener() {
