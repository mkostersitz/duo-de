+package com.android.launcher3.util;
+
+/**
+ * Where a pulled-up app lands when the finger is lifted, as the stock Surface Duo decides it (measured on a stock
+ * Duo 1 with injected drags, see the Duo-DE gesture notes). Distances are in dp so the same rule serves both Duos:
+ * <ul>
+ *   <li>lifted on the app's own screen, more than {@link #MOVE_NEAR_DP} short of the hinge: the app stays;</li>
+ *   <li>between {@link #MOVE_NEAR_DP} and {@link #SPAN_NEAR_DP} short of the hinge: the app moves to the other
+ *       screen;</li>
+ *   <li>from {@link #SPAN_NEAR_DP} short of the hinge to {@link #SPAN_FAR_DP} past its far edge: the app spans both
+ *       screens, if the finger rested there (0 at the hinge centre, up to {@link #MAX_DWELL_MS} at the zone edge),
+ *       otherwise it moves to the other screen;</li>
+ *   <li>further on, or on the other screen: the app moves there.</li>
+ * </ul>
+ * A spanned app is the same turned round: lifted in the span zone it stays spanned, anywhere else it moves to the
+ * screen it was dropped on.
+ */
+public final class DuoDragDrop {
+    private DuoDragDrop() { }
+
+    public static final int NONE = 0;
+    public static final int MOVE_TO_LEFT = 1;
+    public static final int MOVE_TO_RIGHT = 2;
+    public static final int SPAN = 3;
+
+    /** The span zone starts this far short of the hinge, on the screen the app is on. */
+    public static final float SPAN_NEAR_DP = 20f;
+    /** The span zone ends this far past the hinge, on the other screen. */
+    public static final float SPAN_FAR_DP = 60f;
+    /** Lifted between this and SPAN_NEAR_DP short of the hinge the app already moves. */
+    public static final float MOVE_NEAR_DP = 60f;
+    /** Rest needed at the edge of the span zone; shorter towards the hinge centre. */
+    public static final long MAX_DWELL_MS = 480;
+    /** A finger that has moved less than this since the pause started is resting. */
+    public static final float REST_DP = 6f;
+
+    /** True when x is inside the span zone. {@code halves} is {@link DuoPanels#halves}. */
+    public static boolean inSpanZone(int[][] halves, boolean fromRight, float x, float density) {
+        final float left = halves[0][2];
+        final float right = halves[1][0];
+        // Left-origin frame: the app's own screen is on the low side.
+        final float u = fromRight ? left + right - x : x;
+        return u >= left - SPAN_NEAR_DP * density && u <= right + SPAN_FAR_DP * density;
+    }
+
+    /** The rest the finger needs at x for the app to span: none at the hinge centre, MAX_DWELL_MS at the zone edge. */
+    public static long requiredDwellMs(int[][] halves, float x, float density) {
+        final float centre = (halves[0][2] + halves[1][0]) / 2f;
+        final float half = (halves[1][0] - halves[0][2]) / 2f + SPAN_NEAR_DP * density;
+        return (long) (MAX_DWELL_MS * Math.min(1f, Math.abs(x - centre) / half));
+    }
+
+    /**
+     * What happens to an app on one screen, lifted at x.
+     *
+     * @param fromRight true when the app is on the right screen
+     */
+    public static int decideForPanelApp(int[][] halves, boolean fromRight, float x, long dwellMs, float density) {
+        final float left = halves[0][2];
+        final float right = halves[1][0];
+        final float u = fromRight ? left + right - x : x;     // left-origin frame
+        final int other = fromRight ? MOVE_TO_LEFT : MOVE_TO_RIGHT;
+        if (u < left - MOVE_NEAR_DP * density) return NONE;
+        if (u < left - SPAN_NEAR_DP * density) return other;
+        if (u <= right + SPAN_FAR_DP * density) {
+            return dwellMs >= requiredDwellMs(halves, x, density) ? SPAN : other;
+        }
+        return other;
+    }
+
+    /** What happens to a spanned app lifted at x: it stays in the span zone, else lands on the screen under x. */
+    public static int decideForSpannedApp(int[][] halves, float x, long dwellMs, float density) {
+        final float left = halves[0][2];
+        final float right = halves[1][0];
+        if (x >= left - SPAN_NEAR_DP * density && x <= right + SPAN_NEAR_DP * density) return NONE;
+        return x < left ? MOVE_TO_LEFT : MOVE_TO_RIGHT;
+    }
+}
