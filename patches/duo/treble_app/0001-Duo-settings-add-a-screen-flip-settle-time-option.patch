From 9bff6a703eb569b788270c8d90a6fea5e26faf58 Mon Sep 17 00:00:00 2001
From: Mike Kostersitz <mkostersitz@mac.com>
Date: Fri, 16 Oct 2026 02:35:14 +0000
Subject: [PATCH] Duo settings: add a screen flip settle time option

Lists 0.25 s to 4 s under Posture and writes persist.sys.phh.duo.flip_settle_ms,
which the posture service reads on every flip between the two single screens.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 app/src/main/java/me/phh/treble/app/Duo.kt    | 11 ++++++++++
 .../java/me/phh/treble/app/DuoSettings.kt     |  1 +
 app/src/main/res/values/pref_duo.xml          | 20 +++++++++++++++++++
 app/src/main/res/xml/pref_duo.xml             |  8 ++++++++
 4 files changed, 40 insertions(+)

diff --git a/app/src/main/java/me/phh/treble/app/Duo.kt b/app/src/main/java/me/phh/treble/app/Duo.kt
index bfdca63..5728d1b 100644
--- a/app/src/main/java/me/phh/treble/app/Duo.kt
+++ b/app/src/main/java/me/phh/treble/app/Duo.kt
@@ -58,6 +58,17 @@ object Duo: EntryStartup {
 
             }
             
+            DuoSettings.flipSettleTime -> {
+                // Milliseconds the posture service stays in both-screens mode when flipping
+                // straight from one screen to the other. Only plain integers are accepted.
+                val value = sp.getString(key, "2000") ?: "2000"
+                if (value.toLongOrNull() != null) {
+                    Misc.safeSetprop("persist.sys.phh.duo.flip_settle_ms", value)
+                } else {
+                    Misc.safeSetprop("persist.sys.phh.duo.flip_settle_ms", "2000")
+                }
+            }
+
             DuoSettings.wirelessPenCharging -> {
                 // Retrieve the boolean value from shared preferences
                 val b = sp.getBoolean(key, false)
diff --git a/app/src/main/java/me/phh/treble/app/DuoSettings.kt b/app/src/main/java/me/phh/treble/app/DuoSettings.kt
index 740dff3..b1d3819 100644
--- a/app/src/main/java/me/phh/treble/app/DuoSettings.kt
+++ b/app/src/main/java/me/phh/treble/app/DuoSettings.kt
@@ -11,6 +11,7 @@ import android.util.Log
 object DuoSettings : Settings {
     val disableHingeGap = "key_disable_hinge_gap"
     val lockSingleScreenPosture = "key_duo_posture_lock"
+    val flipSettleTime = "key_duo_flip_settle_ms"
     val penChargingCategory = "key_duo_pen_charging_category"
     val wirelessPenCharging = "wireless_pen_charging"
     val chargePenOnlyWhenDeviceIsCharging = "charge_pen_while_device_is_charging"
diff --git a/app/src/main/res/values/pref_duo.xml b/app/src/main/res/values/pref_duo.xml
index fd68ace..522f589 100644
--- a/app/src/main/res/values/pref_duo.xml
+++ b/app/src/main/res/values/pref_duo.xml
@@ -20,4 +20,24 @@
       <item>"top"</item>
       <item>"bottom"</item>
     </array>
+    <array name="pref_flip_settle_entries">
+        <item>0.25 seconds</item>
+        <item>0.5 seconds</item>
+        <item>0.75 seconds</item>
+        <item>1 second</item>
+        <item>1.5 seconds</item>
+        <item>2 seconds (default)</item>
+        <item>3 seconds</item>
+        <item>4 seconds</item>
+    </array>
+    <array name="pref_flip_settle_values">
+        <item>250</item>
+        <item>500</item>
+        <item>750</item>
+        <item>1000</item>
+        <item>1500</item>
+        <item>2000</item>
+        <item>3000</item>
+        <item>4000</item>
+    </array>
 </resources>
diff --git a/app/src/main/res/xml/pref_duo.xml b/app/src/main/res/xml/pref_duo.xml
index 409b099..27fc771 100644
--- a/app/src/main/res/xml/pref_duo.xml
+++ b/app/src/main/res/xml/pref_duo.xml
@@ -16,6 +16,14 @@
             android:key="key_duo_posture_lock"
             android:title="Default Screen in Single-screen postures" 
         />
+        <ListPreference
+            android:defaultValue="2000"
+            android:entries="@array/pref_flip_settle_entries"
+            android:entryValues="@array/pref_flip_settle_values"
+            android:key="key_duo_flip_settle_ms"
+            android:title="Screen flip settle time"
+            android:summary="%s. How long both screens stay on when flipping from one screen to the other, so touch keeps working. Shorter is faster but may lose touch."
+        />
     </PreferenceCategory>
 
     <PreferenceCategory android:title="Pen Charging" android:key="key_duo_pen_charging_category">
-- 
2.43.0

