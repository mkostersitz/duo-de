From ae41093808e83fc060be6a412594ae33e4858330 Mon Sep 17 00:00:00 2001
From: mkostersitz <spartan114@me.com>
Date: Tue, 20 Oct 2026 16:18:35 +0000
Subject: [PATCH 4/6] Duo settings: Microsoft Launcher behavior option
 (Original Duo or Android tablet)

New "Microsoft Launcher" section with a radio-button list. Sets persist.sys.phh.duo.msl_mode and
restarts the launcher so it re-reads the Surface features (see the frameworks/base patch).

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 app/src/main/AndroidManifest.xml                 |  1 +
 app/src/main/java/me/phh/treble/app/Duo.kt       | 16 ++++++++++++++++
 .../main/java/me/phh/treble/app/DuoSettings.kt   |  1 +
 app/src/main/res/values/pref_duo.xml             |  8 ++++++++
 app/src/main/res/xml/pref_duo.xml                | 11 +++++++++++
 5 files changed, 37 insertions(+)

diff --git a/app/src/main/AndroidManifest.xml b/app/src/main/AndroidManifest.xml
index 0b30cc9..27a730b 100644
--- a/app/src/main/AndroidManifest.xml
+++ b/app/src/main/AndroidManifest.xml
@@ -14,6 +14,7 @@
     <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
 
     <uses-permission android:name="android.permission.VIBRATE" />
+    <uses-permission android:name="android.permission.FORCE_STOP_PACKAGES" />
 
     <application
         android:allowBackup="true"
diff --git a/app/src/main/java/me/phh/treble/app/Duo.kt b/app/src/main/java/me/phh/treble/app/Duo.kt
index bfdca63..0f089a3 100644
--- a/app/src/main/java/me/phh/treble/app/Duo.kt
+++ b/app/src/main/java/me/phh/treble/app/Duo.kt
@@ -31,6 +31,22 @@ object Duo: EntryStartup {
                 Misc.safeSetprop("persist.sys.phh.duo.disable_hinge", value)
             }
 
+            DuoSettings.mslMode -> {
+                val mode = if (sp.getString(key, "duo") == "tablet") "tablet" else "duo"
+                if (SystemProperties.get("persist.sys.phh.duo.msl_mode", "duo") != mode) {
+                    Misc.safeSetprop("persist.sys.phh.duo.msl_mode", mode)
+                    // The launcher reads the features once at startup: restart it to apply the new mode.
+                    try {
+                        val am = ctxt?.getSystemService(android.app.ActivityManager::class.java)
+                        android.app.ActivityManager::class.java
+                            .getMethod("forceStopPackage", String::class.java)
+                            .invoke(am, "com.microsoft.launcher")
+                    } catch (e: Exception) {
+                        Log.e("PHH", "Could not restart Microsoft Launcher", e)
+                    }
+                }
+            }
+
             DuoSettings.lockSingleScreenPosture -> {          
                 /*
                     Set as string of one of three variables, convert in posture service to int. 
diff --git a/app/src/main/java/me/phh/treble/app/DuoSettings.kt b/app/src/main/java/me/phh/treble/app/DuoSettings.kt
index 740dff3..01608af 100644
--- a/app/src/main/java/me/phh/treble/app/DuoSettings.kt
+++ b/app/src/main/java/me/phh/treble/app/DuoSettings.kt
@@ -11,6 +11,7 @@ import android.util.Log
 object DuoSettings : Settings {
     val disableHingeGap = "key_disable_hinge_gap"
     val lockSingleScreenPosture = "key_duo_posture_lock"
+    val mslMode = "key_duo_msl_mode"
     val penChargingCategory = "key_duo_pen_charging_category"
     val wirelessPenCharging = "wireless_pen_charging"
     val chargePenOnlyWhenDeviceIsCharging = "charge_pen_while_device_is_charging"
diff --git a/app/src/main/res/values/pref_duo.xml b/app/src/main/res/values/pref_duo.xml
index fd68ace..8b30d45 100644
--- a/app/src/main/res/values/pref_duo.xml
+++ b/app/src/main/res/values/pref_duo.xml
@@ -20,4 +20,12 @@
       <item>"top"</item>
       <item>"bottom"</item>
     </array>
+    <string-array name="pref_msl_mode_entries">
+        <item>Original Duo</item>
+        <item>Android tablet</item>
+    </string-array>
+    <string-array name="pref_msl_mode_values">
+        <item>duo</item>
+        <item>tablet</item>
+    </string-array>
 </resources>
diff --git a/app/src/main/res/xml/pref_duo.xml b/app/src/main/res/xml/pref_duo.xml
index 409b099..b9c8496 100644
--- a/app/src/main/res/xml/pref_duo.xml
+++ b/app/src/main/res/xml/pref_duo.xml
@@ -18,6 +18,17 @@
         />
     </PreferenceCategory>
 
+    <PreferenceCategory android:title="Microsoft Launcher">
+        <ListPreference
+            android:defaultValue="duo"
+            android:entries="@array/pref_msl_mode_entries"
+            android:entryValues="@array/pref_msl_mode_values"
+            android:key="key_duo_msl_mode"
+            android:title="Launcher behavior"
+            android:summary="%s. Original Duo: hinge-aware dual-screen layout. Android tablet: the plain tablet layout. Restarts Microsoft Launcher."
+        />
+    </PreferenceCategory>
+
     <PreferenceCategory android:title="Pen Charging" android:key="key_duo_pen_charging_category">
         <SwitchPreference
             android:defaultValue="false"
-- 
