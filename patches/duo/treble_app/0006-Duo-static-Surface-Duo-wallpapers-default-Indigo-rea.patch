+++ b/app/src/main/java/me/phh/treble/app/DuoWallpapers.kt
@@ -0,0 +1,91 @@
+package me.phh.treble.app
+
+import android.app.Activity
+import android.app.WallpaperManager
+import android.content.Context
+import android.os.Bundle
+import android.preference.PreferenceManager
+import android.util.Log
+import android.view.ViewGroup
+import android.widget.Button
+import android.widget.LinearLayout
+import android.widget.ScrollView
+import android.widget.TextView
+import android.widget.Toast
+import java.io.File
+import java.io.FileInputStream
+
+/**
+ * The stock Surface Duo wallpapers live on the vendor partition (/vendor/app/surface_wallpapers). This applies one as a
+ * STATIC wallpaper: a live wallpaper layer makes the other panel stay black after a flip on the Duo 2, so it is not
+ * used. Nothing is copied into the system image, the files are read at runtime.
+ */
+object DuoWallpapers : EntryStartup {
+    const val DIR = "/vendor/app/surface_wallpapers"
+    private const val PREF_DEFAULT_SET = "duo_wallpapers_default_set"
+    private const val DEFAULT_NAME = "001_surface_duo_indigo.webp"
+
+    fun files(): List<File> =
+        (File(DIR).listFiles { f -> f.isFile && f.name.endsWith(".webp") } ?: emptyArray()).sortedBy { it.name }
+
+    /** "001_surface_duo_indigo.webp" -> "Surface Duo Indigo" */
+    fun title(f: File): String =
+        f.nameWithoutExtension.substringAfter('_').split('_').joinToString(" ") { it.replaceFirstChar { c -> c.uppercase() } }
+
+    fun apply(ctx: Context, f: File): Boolean =
+        try {
+            FileInputStream(f).use { input ->
+                WallpaperManager.getInstance(ctx).setStream(input, null, true,
+                    WallpaperManager.FLAG_SYSTEM or WallpaperManager.FLAG_LOCK)
+            }
+            true
+        } catch (e: Exception) {
+            Log.e("PHH", "Could not set wallpaper ${f.name}", e)
+            false
+        }
+
+    override fun startup(ctxt: Context) {
+        if (!DuoSettings.enabled()) return
+        val sp = PreferenceManager.getDefaultSharedPreferences(ctxt)
+        if (sp.getBoolean(PREF_DEFAULT_SET, false)) return
+        val default = files().firstOrNull { it.name == DEFAULT_NAME } ?: return
+        // Only on the very first run: never replace a wallpaper the user chose later.
+        if (apply(ctxt, default)) {
+            sp.edit().putBoolean(PREF_DEFAULT_SET, true).apply()
+            Log.d("PHH", "Default wallpaper set to ${default.name}")
+        }
+    }
+}
+
+class DuoWallpapersActivity : Activity() {
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+        title = "Surface Duo wallpapers"
+        val pad = (16 * resources.displayMetrics.density).toInt()
+        val root = LinearLayout(this).apply {
+            orientation = LinearLayout.VERTICAL
+            setPadding(pad, pad, pad, pad)
+        }
+        root.addView(TextView(this).apply {
+            text = "Pick a Surface Duo wallpaper. It is applied as a static wallpaper (a live wallpaper can leave one " +
+                "screen black after a flip)."
+            textSize = 16f
+        })
+        val files = DuoWallpapers.files()
+        if (files.isEmpty()) {
+            root.addView(TextView(this).apply { text = "No wallpapers found in ${DuoWallpapers.DIR}." })
+        }
+        for (f in files) {
+            root.addView(Button(this).apply {
+                text = DuoWallpapers.title(f)
+                setOnClickListener {
+                    val ok = DuoWallpapers.apply(this@DuoWallpapersActivity, f)
+                    Toast.makeText(this@DuoWallpapersActivity,
+                        if (ok) "Wallpaper set: ${DuoWallpapers.title(f)}" else "Could not set the wallpaper",
+                        Toast.LENGTH_SHORT).show()
+                }
+            }, LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT))
+        }
+        setContentView(ScrollView(this).apply { addView(root) })
+    }
+}
