From d3f06d7f45e38f7faf16a1dd008255cad63cd561 Mon Sep 17 00:00:00 2001
From: Mike Kostersitz <mkostersitz@mac.com>
Date: Mon, 5 Oct 2026 00:01:29 -0700
Subject: [PATCH] Drop ParanoidSense and OmniJaws from the product

Both depend on modules that are only in ponces' private vendor repo
(vendor.aospa.biometrics.face, ax_compose, crdroid apps resources) and
cannot be built from public sources.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 config/common.mk   | 7 -------
 config/packages.mk | 4 ----
 2 files changed, 11 deletions(-)

diff --git a/config/common.mk b/config/common.mk
index 86b53a7..d2b4cf5 100644
--- a/config/common.mk
+++ b/config/common.mk
@@ -12,13 +12,6 @@ endif
 PRODUCT_COPY_FILES += \
     frameworks/native/data/etc/android.software.sip.voip.xml:$(TARGET_COPY_OUT_PRODUCT)/etc/permissions/android.software.sip.voip.xml
 
-# Face Unlock
-PRODUCT_PACKAGES += \
-    ParanoidSense
-
-PRODUCT_SYSTEM_EXT_PROPERTIES += \
-    ro.face.sense_service=true
-
 PRODUCT_COPY_FILES += \
     frameworks/native/data/etc/android.hardware.biometrics.face.xml:$(TARGET_COPY_OUT_SYSTEM)/etc/permissions/android.hardware.biometrics.face.xml
 
diff --git a/config/packages.mk b/config/packages.mk
index 88154e8..d00a3ae 100644
--- a/config/packages.mk
+++ b/config/packages.mk
@@ -8,7 +8,3 @@ PRODUCT_PACKAGES += \
 # SystemUI plugins
 PRODUCT_PACKAGES += \
     QuickAccessWallet
-
-# Weather
-PRODUCT_PACKAGES += \
-    OmniJaws
-- 
2.53.0

